// Let administrators (sudo/adm group) on a local, active session start, stop and enable the
// GExam service from the control panel without typing a password each time.
polkit.addRule(function(action, subject) {
  var unit = action.lookup("unit");
  var isGexam = unit && String(unit).indexOf("gexam.service") !== -1;
  var admin = subject.local && subject.active && (subject.isInGroup("sudo") || subject.isInGroup("adm"));
  if (!admin) return;
  if ((action.id == "org.freedesktop.systemd1.manage-units" ||
       action.id == "org.freedesktop.systemd1.manage-unit-files") && isGexam) {
    return polkit.Result.YES;
  }
  if (action.id == "org.freedesktop.systemd1.reload-daemon") {
    return polkit.Result.YES;
  }
});
